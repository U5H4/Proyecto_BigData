# ---------------------------------------------------------------------------
# Credenciales de la Parte Cloud (SQL + NoSQL).
#
# Copia este archivo a `.env` y rellena lo que tengas. NO hace falta nada para
# que el pipeline funcione: si no hay credenciales (o el servidor no responde),
# integration.py degrada a
#   - SQLite local  -> data/processed/integracion/novacommerce.db
#   - NDJSON local  -> data/processed/integracion/mongo/*.ndjson
# y ejecuta las mismas consultas y pipelines, asi que siempre hay resultados.
#
# python-dotenv esta en requirements.txt pero la carga es opcional: si no hay
# .env, se usan los valores por defecto de src/config.py.
# ---------------------------------------------------------------------------

# --- PostgreSQL (local o Supabase) -----------------------------------------
# Local:
#   PG_HOST=localhost / PG_PORT=5432 / PG_USER=postgres ...
#
# Supabase (Panel > Connect). IMPORTANTE: el host directo
# `db.<proyecto>.supabase.co` solo resuelve a IPv6 y en muchas redes no es
# alcanzable, por lo que se recomienda el "Session pooler" (IPv4) de abajo.
PG_SSLMODE=require   # TLS obligatorio en Supabase ("require"); en local "prefer"/"off".

# Supabase via "Session pooler" (IPv4) - recomendado. Si defines SUPABASE_HOST,
# gana sobre las variables PG_*.
SUPABASE_HOST=aws-0-<region>.pooler.supabase.com
SUPABASE_PORT=5432
SUPABASE_DATABASE=postgres
SUPABASE_USER=postgres.<tu-proyecto>
SUPABASE_PASSWORD=tu_clave

# Supabase via conexion directa (solo si tu red tiene IPv6):
# PG_HOST=db.TU-PROYECTO.supabase.co
# PG_PORT=5432
# PG_DATABASE=postgres
# PG_USER=postgres
# PG_PASSWORD=tu_clave

# --- MongoDB Atlas ---------------------------------------------------------
MONGO_URI=mongodb+srv://usuario:clave@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGO_DB=novacommerce
# (Opcional) MONGO_ATLAS_URI tiene prioridad sobre MONGO_URI si esta definido.
# MONGO_ATLAS_URI=mongodb+srv://usuario:clave@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# --- Interruptores de modo (utiles para demostrar ambos caminos) ------------
# Fuerza SQLite aunque haya credenciales de PostgreSQL:
FORZAR_SQLITE=0
# No intentar PostgreSQL:
SIN_POSTGRES=0
# No intentar MongoDB:
SIN_MONGO=0
